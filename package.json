{
  "name": "linkedin-profile-gateway",
  "version": "3.0.3",
  "description": "Hosted LinkedIn profile extraction API with authenticated, paced reads and stable JSON output.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "profile-gateway": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "dev:api": "bun run src/server.ts",
    "start": "bun run dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "bun-types": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "keywords": [
    "linkedin",
    "scraper",
    "voyager",
    "cli",
    "agent",
    "profile-api"
  ],
  "publishConfig": {
    "access": "public"
  }
}
