# Copy to .env for local development. Never commit real values.
LINKEDIN_LI_AT=replace-with-li_at-cookie
LINKEDIN_JSESSIONID=replace-with-JSESSIONID-cookie
LINKEDIN_USER_AGENT=replace-with-the-browser-user-agent-that-created-the-session
LINKEDIN_SESSION_CAPTURED_AT=2026-08-30T00:00:00.000Z
API_KEY=replace-with-a-long-random-api-key
PORT=3000
NODE_ENV=development
# CORS_ORIGIN=https://your-frontend.example
# PROFILE_GATEWAY_CACHE_DIR=/tmp/profile-gateway
